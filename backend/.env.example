# MongoDB connection string
# Local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/smart_salon

# Or MongoDB Atlas (cloud) example:
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/salon

# Server port
PORT=5000

# JWT secret for admin login (change this to any random long string)
JWT_SECRET=change_this_to_a_long_random_secret_key

# Default admin login credentials (used only by seed.js to create the first admin)
ADMIN_EMAIL=admin@queueless.com
ADMIN_PASSWORD=change_me

# Email (forgot password, booking confirmation, reminders). Leave blank to print emails in the console
APP_URL=http://localhost:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Smart Salon <no-reply@yourdomain.com>"
